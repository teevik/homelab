{
  "uid": "proto-journal",
  "title": "Prototype B \u00b7 Journal",
  "description": "What changed, in time order. Deploys (blue), restarts (orange), and alerts (red) are drawn as markers on every chart, and all charts share one crosshair.",
  "tags": [
    "homelab",
    "prototype"
  ],
  "editable": true,
  "graphTooltip": 2,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timezone": "browser",
  "schemaVersion": 39,
  "fiscalYearStartMonth": 0,
  "version": 1,
  "links": [
    {
      "title": "Prototypes",
      "type": "dashboards",
      "tags": [
        "prototype"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "tooltip": "",
      "url": ""
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "name": "Deploys",
        "iconColor": "#5794F2",
        "expr": "changes(argocd_app_sync_total{phase=\"Succeeded\"}[2m]) > 0",
        "step": "1m",
        "titleFormat": "Deployed {{name}}",
        "textFormat": "",
        "tagKeys": "name",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "name": "Restarts",
        "iconColor": "#FF9830",
        "expr": "increase(kube_pod_container_status_restarts_total[2m]) > 0",
        "step": "1m",
        "titleFormat": "Restarted {{pod}}",
        "textFormat": "{{namespace}} \u00b7 {{container}}",
        "tagKeys": "namespace",
        "useValueForTime": false
      },
      {
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "enable": true,
        "hide": false,
        "name": "Alerts",
        "iconColor": "#F2495C",
        "expr": "ALERTS{alertstate=\"firing\",alertname!~\"Watchdog|InfoInhibitor\"}",
        "step": "1m",
        "titleFormat": "{{alertname}}",
        "textFormat": "{{severity}}",
        "tagKeys": "severity",
        "useValueForTime": false
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Deploys",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 5,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(increase(argocd_app_sync_total{phase=\"Succeeded\"}[$__range])) or vector(0)",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto",
        "wideLayout": true,
        "showPercentChange": false
      }
    },
