    {
      "id": 9,
      "type": "state-timeline",
      "title": "Application state \u00b7 last 24 h",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 16,
        "h": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max by (name) (argocd_app_info{health_status=\"Healthy\",sync_status=\"Synced\"} * 2 or argocd_app_info{health_status=\"Healthy\",sync_status!=\"Synced\"} * 1 or argocd_app_info{health_status!=\"Healthy\"} * 0)",
          "legendFormat": "{{name}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Unhealthy",
                  "color": "red",
                  "index": 0
                },
                "1": {
                  "text": "Out of sync",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "Healthy",
                  "color": "green",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "fillOpacity": 85,
            "lineWidth": 0,
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "never",
        "alignValue": "left",
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "description": "One strip per Argo CD application. Green: healthy and synced. Yellow: healthy but out of sync. Red: unhealthy."
    },
    {
      "id": 10,
      "type": "gauge",
      "title": "CPU busy",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 4,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{job=\"node-exporter\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "__auto",
          "refId": "A",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "orientation": "auto",
        "minVizHeight": 60,
        "minVizWidth": 60,
        "sizing": "auto"
      }
    },
