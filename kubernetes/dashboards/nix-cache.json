      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "A",
          "expr": "sum by (http_method, http_route) (rate(http_server_request_duration_seconds_count{job=\"nix-cache-ncps\",http_route!=\"\",http_route!~\"/(metrics|healthz|nix-cache-info)\"}[$__rate_interval]))",
          "legendFormat": "{{http_method}} {{http_route}}",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "calcs": [
