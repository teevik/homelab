      "id": 14,
      "type": "timeseries",
      "title": "Upstream HTTP responses and transport errors",
      "description": "404 is an expected lookup miss. Transport errors can include cancelled losing requests when ncps races upstreams; they do not necessarily mean a client download failed.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 22,
        "w": 12,
