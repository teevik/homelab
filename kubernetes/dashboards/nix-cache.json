          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"nix-cache-ncps\",http_route!=\"\",http_route!~\"/(metrics|healthz|nix-cache-info)\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "range": true,
          "instant": false
        }
      ],
      "options": {
        "legend": {
          "calcs": [
