{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Oslo",

  // Regex managers handle Nix-embedded images and local Helm charts. Native
  // managers update workflow actions and flake inputs.
  "enabledManagers": ["custom.regex", "github-actions", "nix"],
  "nix": {
    "enabled": true
  },

  // Grouping strategy:
  //   - Docker minor, patch, digest, and pin updates share one PR.
  //   - Docker majors and every Helm chart get independent PRs.
  //   - Major updates and every update to a 0.x chart are labeled for review.
  //   - The Dependency Dashboard tracks every detected dependency and PR.
  "dependencyDashboard": true,
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",

  // Generated manifests are committed by this workflow bot. Ignore that
  // author so Renovate can recreate its branch, then let the workflow rerun.
  "gitIgnoredAuthors": ["github-actions[bot]@users.noreply.github.com"],
  "separateMinorPatch": false,

  // Custom managers preserve Nix syntax while updating container images and
  // the version field in each immutable local Helm chart record.
  "customManagers": [
    {
      // Matches: image = "registry/name:tag@sha256:digest"; or image = "registry/name:tag";
      // The (?:@(?<currentDigest>...))? group is optional.
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.*\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+?)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "autoReplaceStringTemplate": "image = \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\"",
      "datasourceTemplate": "docker"
    },
    {
      // Matches comment-annotated Helm image.tag values. Recursive matching
      // extracts the annotation first, then replaces only the quoted value so
      // pinDigests can add a digest without reconstructing the Nix attribute.
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.*\\.nix$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+.*?image\\.tag\\s*=\\s*\\n?\\s*\"[^\"]+\"",
        "\"(?<currentValue>[^@\"]+?)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "autoReplaceStringTemplate": "\"{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
    },
    {
      // Local chart records keep the repository, chart, version, and Nix hash
      // together. CI refreshes the hash for the exact Renovate-selected version.
      "customType": "regex",
      "managerFilePatterns": ["/^charts\\/.+\\/default\\.nix$/"],
      "matchStrings": [
        "repo\\s*=\\s*\"(?<registryUrl>[^\"]+)\";\\s*chart\\s*=\\s*\"(?<depName>[^\"]+)\";\\s*version\\s*=\\s*\"(?<currentValue>[^\"]+)\";"
      ],
      "autoReplaceStringTemplate": "repo = \"{{{registryUrl}}}\";\n  chart = \"{{{depName}}}\";\n  version = \"{{{newValue}}}\";",
      "datasourceTemplate": "helm"
    }
  ],

  "packageRules": [
    {
      // Ignore kodekamp images -- user doesn't want updates
      "matchPackageNames": ["/teevik\\/kodekamp/"],
      "enabled": false
    },
    {
      // Ignore mongo for kodekamp
      "matchPackageNames": ["mongo"],
      "enabled": false
    },
    {
      // Group immich server + ML updates together (they share version numbers)
      "matchPackageNames": ["/immich/"],
      "groupName": "immich"
    },
    {
      // Immich ML uses -rocm suffix tags; only match tags like v1.2.3-rocm
      "matchPackageNames": ["ghcr.io/immich-app/immich-machine-learning"],
      "allowedVersions": "/-rocm$/"
    },
    {
      // Preserve the PostgreSQL compatibility prefix while comparing the
      // VectorChord release embedded in tags such as pg16-v1.1.1.
      "matchPackageNames": ["docker.io/tensorchord/vchord-postgres"],
      "versioning": "regex:^pg(?<compatibility>\\d+)-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$"
    },
    {
      // Pin digests for all docker images
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      // The k8s-stack chart copies the VictoriaLogs image tag verbatim into an
      // app.kubernetes.io/version label; a digest suffix exceeds the 63-char limit.
      "matchPackageNames": ["victoriametrics/victoria-logs"],
      "pinDigests": false
    },
    {
      // Create major-update PRs immediately, but mark them for careful review
      // regardless of whether they come from Docker, Helm, or another manager.
      "matchUpdateTypes": ["major"],
      "addLabels": ["ready-for-human"]
    },
    {
      // SemVer permits breaking minor and patch releases before 1.0. Mark
      // every update to a 0.x chart for the same careful review.
      "matchDatasources": ["helm"],
      "matchCurrentVersion": "/^0\\./",
      "addLabels": ["ready-for-human"]
    },
    {
      // Fold every non-major Docker image update into one PR. Docker majors
      // and all Helm charts remain independent.
      "matchDatasources": ["docker"],
      "matchPackageNames": ["*"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    }
  ]
}
