{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Oslo",

  // Disable all default managers -- we only want our custom ones for .nix files
  "enabledManagers": ["custom.regex"],

  // Single-PR mode: one always-up-to-date PR + a dashboard issue listing
  // every detected dependency
  "dependencyDashboard": true,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "recreateWhen": "always",

  // Custom managers for container image references in .nix files.
  // Each manager uses a SINGLE regex with an optional digest group so the
  // same line is never matched twice (which produces upgrade-collision
  // warnings and prevents Renovate from creating a branch).
  "customManagers": [
    {
      // Matches: image = "registry/name:tag@sha256:digest"; or image = "registry/name:tag";
      // The (?:@(?<currentDigest>...))? group is optional.
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.*\\.nix$/"],
      "matchStrings": [
        "image\\s*=\\s*\"(?<depName>[^:\"]+):(?<currentValue>[^@\"]+?)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      // Matches comment-annotated Helm image.tag values:
      //   # renovate: datasource=docker depName=ghcr.io/immich-app/immich-server
      //   image.tag = "v1.2.3";              (digest optional)
      //   image.tag = "v1.2.3@sha256:abc..."; (digest captured)
      "customType": "regex",
      "managerFilePatterns": ["/kubernetes/.*\\.nix$/"],
      "matchStrings": [
        "#\\s*renovate:\\s*datasource=(?<datasource>[^\\s]+)\\s+depName=(?<depName>[^\\s]+)\\s+.*?image\\.tag\\s*=\\s*\\n?\\s*\"(?<currentValue>[^@\"]+?)(?:@(?<currentDigest>sha256:[a-f0-9]+))?\""
      ]
    }
  ],

  "packageRules": [
    {
      // Ignore kodekamp images -- user doesn't want updates
      "matchPackageNames": ["/teevik\\/kodekamp/"],
      "enabled": false
    },
    {
      // Ignore mongo for kodekamp
      "matchPackageNames": ["mongo"],
      "enabled": false
    },
    {
      // Group immich server + ML updates together (they share version numbers)
      "matchPackageNames": ["/immich/"],
      "groupName": "immich"
    },
    {
      // Immich ML uses -rocm suffix tags; only match tags like v1.2.3-rocm
      "matchPackageNames": ["ghcr.io/immich-app/immich-machine-learning"],
      "allowedVersions": "/-rocm$/"
    },
    {
      // Pin digests for all docker images
      "matchDatasources": ["docker"],
      "pinDigests": true
    },
    {
      // Catch-all: fold every remaining update into a single PR
      "matchPackageNames": ["*"],
      "groupName": "all dependencies",
      "groupSlug": "all"
    }
  ]
}
